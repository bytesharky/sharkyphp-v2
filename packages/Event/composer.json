{
    "name": "sharkyphp/event",
    "description": "SharkyPHP Event subpackage, PSR-14 compliant event dispatcher",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Sharky\\Event\\": "src"
        }
    },
    "authors": [
        {
            "name": "bytesharky",
            "email": "fish@doffish.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0"
    },
    "archive": {
        "exclude": [
            "docs/",
            "tests/",
            ".github/",
            ".gitignore",
            "composer.lock",
            "vendor/",
            ".env"
        ]
    }
}
