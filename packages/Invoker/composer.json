{
    "name": "sharkyphp/invoker",
    "description": "SharkyPHP invoker, resolves arguments via container and invokes class/method/callable.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Sharky\\Invoker\\": "src"
        }
    },
    "authors": [
        {
            "name": "bytesharky",
            "email": "fish@doffish.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "psr/container": "^2.0",
        "sharkyphp/container": "^2.0.0"
    },
    "archive": {
        "exclude": [
            "docs/",
            "tests/",
            ".github/",
            ".gitignore",
            "composer.lock",
            "vendor/",
            ".env"
        ]
    }
}
